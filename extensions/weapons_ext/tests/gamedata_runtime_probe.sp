/** Migration-only isolated-server probe. Never enable hooks or call the resolved functions. */
#pragma semicolon 1
#pragma newdecls required
#include <sourcemod>
#include <sdktools>
public Plugin myinfo = {name="Weapons Gamedata Comparison",author="Hombre",version="1.0"};
int g_Checks, g_Failures, g_Unresolved;
public void OnPluginStart() { RegAdminCmd("sm_weapons_gamedata_compare", Compare, ADMFLAG_ROOT); }
bool SignatureExists(GameData conf, const char[] key) {
    StartPrepSDKCall(SDKCall_Static);
    bool found = PrepSDKCall_SetFromConf(conf, SDKConf_Signature, key);
    Handle call = EndPrepSDKCall();
    delete call; return found;
}
void Check(GameData old, GameData combined, int kind, const char[] key) {
    g_Checks++; bool okay;
    if (kind == 0) okay = old.GetOffset(key) == combined.GetOffset(key);
    else if (kind == 1) okay = old.GetAddress(key) == combined.GetAddress(key);
    else if (kind == 2) { char a[512], b[512]; bool av = old.GetKeyValue(key,a,sizeof(a)); bool bv = combined.GetKeyValue(key,b,sizeof(b)); okay = av == bv && StrEqual(a,b); }
    else { bool av = SignatureExists(old,key); bool bv = SignatureExists(combined,key); okay = av == bv; if (!av) g_Unresolved++; }
    if (!okay) { g_Failures++; PrintToServer("[WeaponsGamedataCompare] FAIL kind=%d key=%s",kind,key); }
}
public Action Compare(int client, int args) {
