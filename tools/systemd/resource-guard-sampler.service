[Unit]
Description=VPS resource metrics sampler
After=network.target

[Service]
Type=simple
User=kogasa
Group=kogasa
WorkingDirectory=/home/kogasa
Environment=HOME=/home/kogasa
Environment=STATE_DIR=/home/kogasa/resource-guard
ExecStart=/home/kogasa/resource_guard.sh sample-loop
Restart=always
RestartSec=5
UMask=0077
StandardOutput=append:/home/kogasa/resource-guard/sampler.out
StandardError=append:/home/kogasa/resource-guard/sampler.out

[Install]
WantedBy=multi-user.target
