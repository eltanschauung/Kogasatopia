[Unit]
Description=VPS resource diagnostics and MGE-only watchdog
After=network.target

[Service]
Type=simple
User=kogasa
Group=kogasa
WorkingDirectory=/home/kogasa
Environment=HOME=/home/kogasa
ExecStart=/home/kogasa/.venvs/resource-guard/bin/python /home/kogasa/Kogasatopia/tools/resource_guard/main.py --interval 3
Restart=always
RestartSec=5
UMask=0077
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
